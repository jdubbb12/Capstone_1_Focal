{
  "openapi": "3.1.0",
  "info": {
    "title": "Focal Backend Foundation",
    "version": "1.0.0",
    "description": "Working account, session, profile and interest APIs. Artwork, uploads, annotations, boards, feed and moderation are schema-only and have no endpoints yet."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Local development (use the same hostname as the Vite client for cookies)"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "get_health",
        "summary": "Process liveness",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error (400/401/403/404/409/413/415/429/500/503 as applicable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "get_health_ready",
        "summary": "Database readiness",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error (400/401/403/404/409/413/415/429/500/503 as applicable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "unavailable"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "operationId": "post_auth_signup",
        "summary": "Create an account and set session cookie",
        "security": [],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error (400/401/403/404/409/413/415/429/500/503 as applicable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Email and username are trimmed and normalized to lowercase. Sets an HttpOnly SameSite=Lax cookie; Secure in production.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Signup"
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "post_auth_login",
        "summary": "Sign in and set session cookie",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error (400/401/403/404/409/413/415/429/500/503 as applicable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "get_auth_me",
        "summary": "Get the private current account",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error (400/401/403/404/409/413/415/429/500/503 as applicable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "post_auth_logout",
        "summary": "Revoke the current session",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "204": {
            "description": "Success"
          },
          "default": {
            "description": "Error (400/401/403/404/409/413/415/429/500/503 as applicable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/users/me": {
      "patch": {
        "operationId": "patch_users_me",
        "summary": "Update the current account",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error (400/401/403/404/409/413/415/429/500/503 as applicable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Email changes require current_password and revoke all sessions, including the current session. The user must sign in again after an email change.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfilePatch"
              }
            }
          }
        }
      }
    },
    "/users/me/password": {
      "put": {
        "operationId": "put_users_me_password",
        "summary": "Change password and revoke all sessions",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "204": {
            "description": "Success"
          },
          "default": {
            "description": "Error (400/401/403/404/409/413/415/429/500/503 as applicable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordChange"
              }
            }
          }
        }
      }
    },
    "/users/me/interests": {
      "put": {
        "operationId": "put_users_me_interests",
        "summary": "Atomically replace selected interests",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error (400/401/403/404/409/413/415/429/500/503 as applicable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InterestSelection"
              }
            }
          }
        }
      }
    },
    "/users/{username}": {
      "get": {
        "operationId": "get_users_username",
        "summary": "Get a public profile without email or credential fields",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicUserResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error (400/401/403/404/409/413/415/429/500/503 as applicable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 50,
              "pattern": "^[a-z0-9_]+$"
            }
          }
        ]
      }
    },
    "/interests": {
      "get": {
        "operationId": "get_interests",
        "summary": "List available interests",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "interests": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Interest"
                      }
                    }
                  },
                  "required": [
                    "interests"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error (400/401/403/404/409/413/415/429/500/503 as applicable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "focal_session",
        "description": "Opaque HttpOnly session cookie set by signup/login. Browser fetch requests must set credentials: include."
      }
    },
    "schemas": {
      "Interest": {
        "type": "object",
        "properties": {
          "interest_id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "interest_id",
          "name"
        ],
        "additionalProperties": false
      },
      "PublicUser": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "integer"
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50,
            "pattern": "^[a-z0-9_]+$"
          },
          "first_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "last_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "creative_role": {
            "type": "string",
            "enum": [
              "2d_artist",
              "3d_designer",
              "architect",
              "other"
            ],
            "default": "other"
          },
          "bio": {
            "type": "string",
            "maxLength": 1000
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "interests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Interest"
            }
          }
        },
        "required": [
          "user_id",
          "username",
          "first_name",
          "last_name",
          "creative_role",
          "bio",
          "created_at",
          "interests"
        ],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "integer"
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50,
            "pattern": "^[a-z0-9_]+$"
          },
          "first_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "last_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "creative_role": {
            "type": "string",
            "enum": [
              "2d_artist",
              "3d_designer",
              "architect",
              "other"
            ],
            "default": "other"
          },
          "bio": {
            "type": "string",
            "maxLength": 1000
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "interests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Interest"
            }
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "user_id",
          "username",
          "first_name",
          "last_name",
          "creative_role",
          "bio",
          "created_at",
          "interests",
          "email",
          "updated_at"
        ],
        "additionalProperties": false
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "user"
        ],
        "additionalProperties": false
      },
      "PublicUserResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/PublicUser"
          }
        },
        "required": [
          "user"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Signup": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50,
            "pattern": "^[a-z0-9_]+$"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          },
          "first_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "last_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "creative_role": {
            "type": "string",
            "enum": [
              "2d_artist",
              "3d_designer",
              "architect",
              "other"
            ],
            "default": "other"
          }
        },
        "required": [
          "email",
          "username",
          "password",
          "first_name",
          "last_name"
        ],
        "additionalProperties": false
      },
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "ProfilePatch": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "last_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50,
            "pattern": "^[a-z0-9_]+$"
          },
          "creative_role": {
            "type": "string",
            "enum": [
              "2d_artist",
              "3d_designer",
              "architect",
              "other"
            ],
            "default": "other"
          },
          "bio": {
            "type": "string",
            "maxLength": 1000
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "current_password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "first_name"
            ]
          },
          {
            "required": [
              "last_name"
            ]
          },
          {
            "required": [
              "username"
            ]
          },
          {
            "required": [
              "creative_role"
            ]
          },
          {
            "required": [
              "bio"
            ]
          },
          {
            "required": [
              "email"
            ]
          }
        ],
        "dependentRequired": {
          "email": [
            "current_password"
          ]
        }
      },
      "PasswordChange": {
        "type": "object",
        "properties": {
          "current_password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true
          },
          "new_password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "additionalProperties": false
      },
      "InterestSelection": {
        "type": "object",
        "properties": {
          "interest_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "maxItems": 50,
            "uniqueItems": true
          }
        },
        "required": [
          "interest_ids"
        ],
        "additionalProperties": false
      }
    }
  }
}
