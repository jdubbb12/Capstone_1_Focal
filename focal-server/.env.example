# Use an EMPTY PostgreSQL database. Do not run the legacy FocalDB.sql first.
# Option A: npm run db:local:init creates an isolated cluster + ignored .env.
# Option B: copy this file to .env and supply your own connection strings.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/focal_development
# Tests refuse a database name not ending in _test; they delete test data.
TEST_DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/focal_test
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=24
# TRUST_PROXY_HOPS=0
